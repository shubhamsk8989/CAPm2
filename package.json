{
  "name": "CAP_3",
  "version": "1.0.0",
  "dependencies": {
    "@cap-js/hana": "^2",
    "@sap/approuter": "^21.4.0",
    "@sap/cds": "^9",
    "@sap/xsenv": "^6.2.0",
    "@sap/xssec": "^4.13.0",
    "hdb": "^2.27.1",
    "passport": "^0.7.0"
  },
  "devDependencies": {
    "@cap-js/sqlite": "^2",
    "@sap/cds-dk": "^9",
    "cds-plugin-ui5": "^0.13.0",
    "sqlite": "^5.1.1",
    "sqlite3": "^6.0.1"
  },
  "scripts": {
    "start": "cds-serve",
    "watch-salesorder": "cds watch --open managesalesorder.salesorder/index.html?sap-ui-xx-viewCache=false --livereload false"
  },
  "private": true,
  "workspaces": [
    "app/*"
  ],
  "sapux": [
    "app/salesorder"
  ],
  "cds": {
    "requires": {
      "db": {
        "[development]": {
          "kind": "hana"
        },
        "[production]": {
          "kind": "hana"
        }
      },
      "uaa": {
        "kind": "xsuaa"
      },
      "auth": {
        "[production]": {
          "strategy": "JWT"
        },
        "[development]": {
          "strategy": "mock",
          "users": {
            "shubham": {
              "roles": [
                "Admin",
                "Viewer"
              ],
              "userAttributes": {
                "PoNumber": [
                  "$UNRESTRICTED"
                ]
              }
            },
            "priya": {
              "roles": [
                "Viewer"
              ],
              "userAttributes": {
                "PoNumber": [
                  "PO-9002",
                  "PO-9003"
                ]
              }
            }
          }
        }
      }
    }
  }
}