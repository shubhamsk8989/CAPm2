  "ID": "d3b07384-d113-4e4b-9759-df1f822f3cdf",
  "createdAt": "2026-04-21T10:00:00.000Z",
  "createdBy": "admin",
  "modifiedAt": "2026-04-21T10:00:00.000Z",
  "modifiedBy": "admin",
  "validFrom": "2026-04-21T10:00:00.000Z",
  "validTo": "9999-12-31T23:59:59.999Z",
